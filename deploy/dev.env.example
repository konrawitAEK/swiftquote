# Copy to deploy/dev.env and fill in; deploy/*.env is git-ignored. Deploy with `make deploy-dev`.
# Project name keeps dev's containers, images and database volume apart from prod's,
# even when both run on the same host.
COMPOSE_PROJECT_NAME=swiftquote-dev
COMPOSE_FILE=docker-compose.yml:docker-compose.deploy.yml
# One backend and the frontend(s) to serve.
COMPOSE_PROFILES=go,next

# Public URLs: the browser calls PUBLIC_API_URL, and CORS_ORIGINS lists where the frontends are served.
PUBLIC_API_URL=https://api-dev.example.com/api/v1
CORS_ORIGINS=https://dev.example.com

# Generate with: openssl rand -base64 48 (never reuse prod's values).
DB_PASSWORD=
JWT_SECRET=

# Host ports, offset from prod's so both stacks fit on one machine.
API_PORT=18080
REACT_PORT=13000
NEXT_PORT=13001
ANGULAR_PORT=13002
