# Copy to deploy/prod.env and fill in; deploy/*.env is git-ignored. Deploy with `make deploy-prod`.
# Project name keeps dev's containers, images and database volume apart from prod's,
# even when both run on the same host.
COMPOSE_PROJECT_NAME=swiftquote-prod
COMPOSE_FILE=docker-compose.yml:docker-compose.deploy.yml
# One backend and the frontend(s) to serve.
COMPOSE_PROFILES=go,next

# Public URLs: the browser calls PUBLIC_API_URL, and CORS_ORIGINS lists where the frontends are served.
PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://app.example.com

# Generate with: openssl rand -base64 48 (never reuse dev's values).
DB_PASSWORD=
JWT_SECRET=

# Host ports, the defaults; dev uses offset ones.
API_PORT=8080
REACT_PORT=3000
NEXT_PORT=3001
ANGULAR_PORT=3002
