{
  "name": "swiftquote-node-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SwiftQuote API (Node.js + Fastify), contract-identical to the Go and Spring services",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pdfkit": "0.20.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
